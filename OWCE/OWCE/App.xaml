<?xml version="1.0" encoding="utf-8"?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:OWCE.Converters"
             xmlns:models="clr-namespace:OWCE.Models"
             xmlns:views="clr-namespace:OWCE.Views"
             x:Class="OWCE.App"
             >
    <Application.Resources>
        <ResourceDictionary>

            <!--
            Colours and the panel and button styles live in the theme files (Themes/*.xaml), which ThemeManager merges in
            at startup. Use DynamicResource for anything that comes from a theme so it follows theme changes.
            -->

            <Color x:Key="lightBackgroundColor">#23354d</Color>
            <Color x:Key="darkBackgroundColor">#1C2D41</Color>
            <Color x:Key="textColor">White</Color>

            <Style TargetType="NavigationPage">
                <Setter Property="BarTextColor" Value="{DynamicResource OnBackgroundColor}" />
                <Setter Property="BackgroundColor" Value="{DynamicResource BackgroundGradientStart}" />
                <Setter Property="BarBackgroundColor" Value="{DynamicResource BackgroundGradientStart}" />
            </Style>

            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
            </Style>

            <Style TargetType="ScrollView">
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style TargetType="RefreshView">
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style TargetType="StackLayout">
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style TargetType="CollectionView">
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <!-- Text that does not set its own colour sits on the page, so it uses the page's text colour. -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource OnBackgroundColor}" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{DynamicResource OnBackgroundColor}" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource MutedTextColor}" />
            </Style>

            <Style TargetType="Editor">
                <Setter Property="TextColor" Value="{DynamicResource OnBackgroundColor}" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource MutedTextColor}" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{DynamicResource OnBackgroundColor}" />
                <Setter Property="TitleColor" Value="{DynamicResource MutedTextColor}" />
            </Style>

            <converters:DivideByTwo x:Key="divideByTwo" />

            <!-- The look of the settings style screens: rounded groups of items under small accent coloured headings. -->
            <Style x:Key="SectionHeaderStyle" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="20,28,20,10" />
            </Style>

            <!-- Red for things like Disconnect. The same in every theme: white text on this is 6.5:1. -->
            <Color x:Key="DangerColor">#B3261E</Color>
            <Color x:Key="OnDangerColor">#FFFFFF</Color>
            <SolidColorBrush x:Key="OnDangerBrush" Color="#FFFFFF" />

            <!-- The small heading at the top of a dashboard panel. -->
            <Style x:Key="PanelCaptionStyle" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CharacterSpacing" Value="1.4" />
                <Setter Property="Margin" Value="20,14,20,0" />
                <Setter Property="VerticalOptions" Value="Start" />
            </Style>

            <!-- Text buttons for dialogs. -->
            <Style x:Key="DialogButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{DynamicResource AccentColor}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="HorizontalOptions" Value="End" />
            </Style>

            <Style x:Key="LabelButtonStyle" TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>

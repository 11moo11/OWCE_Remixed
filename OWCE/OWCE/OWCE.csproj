<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Android is always built (Windows, macOS and Linux). iOS needs a Mac, so it is only a target on macOS by default.
      Visual Studio on Windows with a paired Mac can opt in with: -p:BuildIos=true
      You can always pick targets explicitly with: -p:TargetFrameworks=net10.0-android
    -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) or '$(BuildIos)' == 'true'">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>OWCE</RootNamespace>
    <AssemblyName>OWCE</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>

    <!-- App identity -->
    <ApplicationTitle>OWCE</ApplicationTitle>
    <ApplicationId>com.owcommunity.owce</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
    <CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon + splash. -->
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#ECEC00" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#ECEC00" BaseSize="255,440" />

    <!-- Images (source files are the 3x assets, BaseSize is the 1x size). -->
    <MauiImage Include="Resources\Images\burger_menu.png" Resize="true" BaseSize="40,40" />
    <MauiImage Include="Resources\Images\hamburger.png" Resize="true" BaseSize="14,15" />
    <MauiImage Include="Resources\Images\icon_share.png" Resize="true" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\menu_cancel.png" Resize="true" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\menu_leaderboards.png" Resize="true" BaseSize="20,20" />
    <MauiImage Include="Resources\Images\menu_myrides.png" Resize="true" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\menu_onewheels.png" Resize="true" BaseSize="20,20" />
    <MauiImage Include="Resources\Images\menu_settings.png" Resize="true" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\settings_disconnect.png" Resize="true" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\settings_info.png" Resize="true" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\settings_start_recording.png" Resize="true" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\settings_stop_recording.png" Resize="true" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\swipe_delete.png" Resize="true" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\swipe_rename.png" Resize="true" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\splash_image.png" Resize="true" BaseSize="255,440" />

    <!-- Google Fonts (all under the SIL Open Font License, see Documentation/Fonts.md) that the theme builder can use.
         Each file is registered under its file name, eg Orbitron.ttf is the font family "Orbitron". -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Sample ride data used by MockOWBLE when running on a simulator/emulator in Debug. -->
    <EmbeddedResource Include="Resources\SampleRideData\*.bin" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="AsyncAwaitBestPractices" Version="10.0.0" />
    <PackageReference Include="Mopups" Version="1.3.4" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.154.0" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <!-- sqlite-net-pcl pulls in an old SQLitePCLRaw native build with a known vulnerability, so pin a newer one. -->
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" Condition="!$(TargetFramework.Contains('-android'))" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.14" Condition="$(TargetFramework.Contains('-android'))" />
  </ItemGroup>

</Project>

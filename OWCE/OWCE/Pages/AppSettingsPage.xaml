<?xml version="1.0" encoding="UTF-8" ?>
<pages:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:OWCE.Pages"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="OWCE.Pages.AppSettingsPage"
    x:DataType="pages:AppSettingsPage"
    Title="Settings">

    <pages:BaseContentPage.Resources>
         <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </pages:BaseContentPage.Resources>


    <ScrollView>
        <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,Auto,*" ColumnDefinitions="*,Auto" RowSpacing="16">

            <Label Grid.Row="0" Grid.Column="0" VerticalOptions="Center" TextColor="{DynamicResource OnBackgroundColor}" Text="Imperial units (mph, °F)" />
            <Switch Grid.Row="0" Grid.Column="1" HorizontalOptions="End" IsToggled="{Binding MetricDisplay, Converter={StaticResource InvertedBoolConverter}}" />
             
            <Label Grid.Row="1" Grid.Column="0" VerticalOptions="Center" TextColor="{DynamicResource OnBackgroundColor}" Text="Auto ride recording" />
            <Switch Grid.Row="1" Grid.Column="1" HorizontalOptions="End" IsToggled="{Binding AutoRideRecording}" />
                        
            <Label Grid.Row="2" Grid.Column="0" VerticalOptions="Center" TextColor="{DynamicResource OnBackgroundColor}" Text="Theme" />
            <Picker x:Name="ThemePicker" Grid.Row="2" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" WidthRequest="180" HorizontalTextAlignment="End" Title="Theme" SelectedIndexChanged="ThemePicker_SelectedIndexChanged" />
            <Label x:Name="ThemeDescriptionLabel" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" FontSize="14" TextColor="{DynamicResource MutedTextColor}" />

        </Grid>

    </ScrollView>



</pages:BaseContentPage>


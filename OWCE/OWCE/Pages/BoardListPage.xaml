<?xml version="1.0" encoding="UTF-8"?>
<pages:BaseContentPage  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OWCE.Pages.BoardListPage"
             xmlns:pages="clr-namespace:OWCE.Pages"
             xmlns:converters="clr-namespace:OWCE.Converters"
             xmlns:owce="clr-namespace:OWCE"
             xmlns:views="clr-namespace:OWCE.Views"
             xmlns:popup="clr-namespace:OWCE.Pages.Popup"
             x:DataType="pages:BoardListPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoardIsAvailableOpacityConverter x:Key="boardIsAvailableOpacityConverter" />


        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto" RowSpacing="0">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{DynamicResource BackgroundGradientStart}" Offset="0"/>
                <GradientStop Color="{DynamicResource BackgroundGradientEnd}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
              
        
        <!-- The three tabs slide sideways into each other. Left: past rides. Middle: boards. Right: settings. -->
        <views:TabPager x:Name="Pager" Grid.Row="0">

        <views:PastRidesView x:Name="PastRidesTab" />

        <Grid>
        <Image x:Name="BackgroundLogoImage" HorizontalOptions="Center" VerticalOptions="Center" Source="splash_image.png" Opacity="0.1" />
        <!--
        <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0" Opacity="0.1">
            <Image Source="logo_a.png" />
            <Label FontFamily="SairaExtraCondensed-Bold" HorizontalTextAlignment="Center" FontSize="80" CharacterSpacing="0.29" Text="Onewheel" TextColor="Black" />
            <Label FontFamily="SairaExtraCondensed-Bold" HorizontalTextAlignment="Center" FontSize="36" CharacterSpacing="-0.58" Text="Community Edition" TextColor="Black" Margin="0,-20,0,0" />
        </StackLayout>
            -->

        <RefreshView x:Name="MainRefreshView" Command="{Binding RefreshCommand}" >
            <CollectionView x:Name="MainCollectionView" ItemsSource="{Binding Boards}" Margin="0,0,0,0" SelectionMode="None"> 
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="0" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="owce:OWBaseBoard">
                        <ContentView Padding="16,10,16,15">
                           
                            <Border HeightRequest="121" StrokeShape="RoundRectangle 20" BackgroundColor="{DynamicResource CardColor}">
<Border.GestureRecognizers><TapGestureRecognizer Tapped="BoardCard_Tapped" Command="{Binding Source={x:Reference MainCollectionView}, Path=BindingContext.BoardSelectedCommand}" CommandParameter="{Binding .}" /></Border.GestureRecognizers>

                                
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.14" Offset="0,1" Radius="5" />
                                </Border.Shadow>

                                <Grid>
                                    <Label FontAttributes="Bold" FontSize="16" Text="{Binding BoardModelStringLong}" TextColor="{DynamicResource OnCardColor}" Margin="20,5,0,0" CharacterSpacing="-0.26" />
                                    <Label FontAttributes="Bold" FontSize="30" Text="{Binding Name}" TextColor="{DynamicResource OnCardColor}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                                
                            </Border>
                        </ContentView>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

        <!-- Shown when no boards have been found and nothing is being searched for. Touches go through to the list below. -->
        <VerticalStackLayout x:Name="EmptyHint" IsVisible="False" InputTransparent="True" VerticalOptions="Start" HorizontalOptions="Center" Margin="32,36,32,0" Spacing="10">
            <Label Text="Swipe down to search for wheels" FontSize="18" HorizontalTextAlignment="Center" TextColor="{DynamicResource MutedTextColor}" />
            <ContentView x:Name="EmptyHintArrow" HorizontalOptions="Center" />
        </VerticalStackLayout>
        </Grid>

        <views:SettingsView x:Name="SettingsTab" />

        </views:TabPager>

        <views:NavPill x:Name="Nav" Grid.Row="1" Margin="16,8,16,12" />


        <!--
        <views:FakeNavigationBar>
            <views:FakeNavigationBar.InnerContent>
                <Grid ColumnDefinitions="*,26" ColumnSpacing="18">
                    <Label Text="Scanning..." TextColor="Black" FontFamily="SairaExtraCondensed-SemiBold" FontSize="24" HorizontalOptions="End" VerticalOptions="Center" />
                    <ActivityIndicator Grid.Column="1" WidthRequest="26" HeightRequest="26" IsRunning="true" HorizontalOptions="End" />
                </Grid>
            </views:FakeNavigationBar.InnerContent>
        </views:FakeNavigationBar>
        -->
        
    </Grid>

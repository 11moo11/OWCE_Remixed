<?xml version="1.0" encoding="UTF-8"?>
<pages:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:OWCE.Pages"
    xmlns:views="clr-namespace:OWCE.Views"
    x:Class="OWCE.Pages.BoardPage"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="{Binding Name}">


    <pages:BaseContentPage.Resources>
        <ResourceDictionary>

            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />


        </ResourceDictionary>
    </pages:BaseContentPage.Resources>

    <!--
    <pages:BaseContentPage.Resources>
        
        <rgpopup:PopupPage x:Key="SettingsPopupPage" x:Name="SettingsPopupPage">
            <rgpopup:PopupPage.Animation>
                <rgpopupanimation:ScaleAnimation 
                    PositionIn="Bottom"
                    PositionOut="Bottom"
                    DurationIn="200"
                    DurationOut="200"
                    EasingIn="SinOut"
                    EasingOut="SinIn"
                    HasBackgroundAnimation="True"/>
            </rgpopup:PopupPage.Animation>

            
        </rgpopup:PopupPage>
    </pages:BaseContentPage.Resources>
    -->

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{DynamicResource BackgroundGradientStart}" Offset="0"/>
                <GradientStop Color="{DynamicResource BackgroundGradientEnd}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid RowDefinitions="*,Auto" RowSpacing="0">

        <!-- The three tabs slide sideways into each other. Left: actions. Middle: dashboard. Right: settings. -->
        <views:TabPager x:Name="Pager" Grid.Row="0">

        <!-- Actions tab -->
        <Grid x:Name="ActionsView" x:DataType="pages:BoardPage" RowDefinitions="Auto,*,Auto" Padding="16,0,16,8">
            <Label Grid.Row="0" Text="Actions" FontSize="34" TextColor="{DynamicResource OnBackgroundColor}" Margin="4,12,4,20" />

            <VerticalStackLayout Grid.Row="1" Spacing="12">
                <views:MenuButton Text="Record ride" IconSource="settings_start_recording"
                                  Command="{Binding StartRecordRideCommand}"
                                  IsVisible="{Binding Board.IsRecordingRide, Converter={StaticResource InvertedBoolConverter}}" />
                <views:MenuButton Text="Stop recording ride" IconSource="settings_stop_recording"
                                  Command="{Binding StopRecordRideCommand}"
                                  IsVisible="{Binding Board.IsRecordingRide}" />
                <views:MenuButton Text="Reorder dashboard panels" IconPathData="{x:Static views:Icons.Dashboard}"
                                  Command="{Binding EditPanelsCommand}" />
            </VerticalStackLayout>

            <!-- Kept apart from the everyday buttons and in red so it is never hit by accident. -->
            <views:MenuButton Grid.Row="2" IsDanger="True" Text="Disconnect from board" IconSource="settings_disconnect" Tapped="Disconnect_Tapped" />
        </Grid>

        <!-- Dashboard tab -->
        <ScrollView x:Name="DashboardView">
            <StackLayout Spacing="16" Margin="0,16,0,16">
                <!-- The panels are created here, with their bindings, and then handed to the PanelBoard (see SetupPanels),
                     which lets the user move and resize them. This container is never shown. -->
                <VerticalStackLayout x:Name="PanelSource" IsVisible="False">
                    <views:SpeedRangeDistanceView x:Name="SpeedRangeDistanceView" HeightRequest="180" RPM="{Binding RPM}" WheelCircumference="{Binding WheelCircumference}" LifetimeOdometer="{Binding LifetimeOdometer}" TripOdometer="{Binding TripOdometer}" />
                    <views:BatteryPowerView x:Name="BatteryPowerPanel" BindingContext="{Binding .}" />
                    <views:TemperatureView x:Name="TemperatureView" BindingContext="{Binding .}" ControllerTemp="{Binding ControllerTemperature}" MotorTemp="{Binding MotorTemperature}" BatteryTemp="{Binding BatteryTemperature}" />
                    <views:RideModeView x:Name="RideModePanel" BindingContext="{Binding .}" BoardType="{Binding BoardType}" SimpleStopEnabled="{Binding SimpleStopEnabled}" />
                    <views:LightsView x:Name="LightsPanel" BindingContext="{Binding .}" />
                </VerticalStackLayout>
                <views:PanelBoard x:Name="Panels" />
                <!--
                These are removed for now to make way for bluetooth subscription limits on Android.
                They may come back later in the way of a diagnostics screen.
                <views:AngleView IsVisible="false" BindingContext="{Binding .}" Pitch="{Binding Pitch}" Yaw="{Binding Yaw}" Roll="{Binding Roll}"   />
                <views:FootpadsView IsVisible="false" />
                -->
                <Grid Padding="20,0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                    <Label Grid.Row="0" Grid.Column="0" Text="Serial number" FontSize="16" TextColor="{DynamicResource MutedTextColor}" />
                    <Label Grid.Row="1" Grid.Column="0" Text="Battery serial number" FontSize="16" TextColor="{DynamicResource MutedTextColor}" />
                    <Label Grid.Row="2" Grid.Column="0" Text="Hardware revision" FontSize="16" TextColor="{DynamicResource MutedTextColor}" />
                    <Label Grid.Row="3" Grid.Column="0" Text="Firmware" FontSize="16" TextColor="{DynamicResource MutedTextColor}" />
                    <Label Grid.Row="4" Grid.Column="0" Text="RSSI" FontSize="16" TextColor="{DynamicResource MutedTextColor}" />
                    <Label Grid.Row="5" Grid.Column="0" Text="App Version" FontSize="16" TextColor="{DynamicResource MutedTextColor}" />

                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding SerialNumber}" FontSize="16" TextColor="{DynamicResource MutedTextColor}" HorizontalOptions="End" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding BatterySerial}" FontSize="16" TextColor="{DynamicResource MutedTextColor}" HorizontalOptions="End" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding HardwareRevision}" FontSize="16" TextColor="{DynamicResource MutedTextColor}" HorizontalOptions="End" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding FirmwareRevision}" FontSize="16" TextColor="{DynamicResource MutedTextColor}" HorizontalOptions="End" />
                    <Label Grid.Row="4" Grid.Column="1" Text="{Binding RSSI}" FontSize="16" TextColor="{DynamicResource MutedTextColor}" HorizontalOptions="End" />
                    <Label Grid.Row="5" Grid.Column="1" x:Name="AppVersionLabel" FontSize="16" TextColor="{DynamicResource MutedTextColor}" HorizontalOptions="End" />
                </Grid>
            </StackLayout>
        </ScrollView>


        <!-- Settings tab (with About at the bottom) -->
        <views:SettingsView x:Name="SettingsTab" />

        </views:TabPager>

        <views:NavPill x:Name="Nav" Grid.Row="1" Margin="16,8,16,12" />

        </Grid>
    </Grid>
</pages:BaseContentPage>

<?xml version="1.0" encoding="UTF-8"?>
<pages:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:OWCE.Pages"
    xmlns:views="clr-namespace:OWCE.Views"
    x:Class="OWCE.Pages.BoardPage"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="{Binding Name}">


    <pages:BaseContentPage.Resources>
        <ResourceDictionary>

            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />

            <DataTemplate x:Key="SideMenu" x:DataType="pages:BoardPage">
               

                <Grid BackgroundColor="{DynamicResource SurfaceColor}" ColumnSpacing="0" RowSpacing="8" VerticalOptions="Fill" RowDefinitions="Auto,1,Auto,1,*,Auto">
                    
                    <Grid Grid.Row="0" RowDefinitions="Auto" ColumnDefinitions="60,*" ColumnSpacing="0" IsVisible="{Binding Board.IsRecordingRide, Converter={StaticResource InvertedBoolConverter}}">
<Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding StartRecordRideCommand}" /></Grid.GestureRecognizers>
                        <Image Grid.Row="0" Grid.Column="0" Source="settings_start_recording" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center">
<Image.Behaviors><views:ThemedIconTint ThemeColorKey="OnSurfaceColor" /></Image.Behaviors>
</Image>
                        <Label Grid.Row="0" Grid.Column="1" Text="Record ride" TextColor="{DynamicResource OnSurfaceColor}" FontSize="18"/>
                    </Grid>
                                        
                    <Grid Grid.Row="0" RowDefinitions="Auto" ColumnDefinitions="60,*" ColumnSpacing="0" IsVisible="{Binding Board.IsRecordingRide}">
<Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding StopRecordRideCommand}" /></Grid.GestureRecognizers>
                        <Image Grid.Row="0" Grid.Column="0" Source="settings_stop_recording" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center">
<Image.Behaviors><views:ThemedIconTint ThemeColorKey="OnSurfaceColor" /></Image.Behaviors>
</Image>
                        <Label Grid.Row="0" Grid.Column="1" Text="Stop recording ride" TextColor="{DynamicResource OnSurfaceColor}" FontSize="18"/>
                    </Grid>

                    <Grid Grid.Row="2" RowDefinitions="Auto" ColumnDefinitions="60,*" ColumnSpacing="0">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditPanelsCommand}" />
                        </Grid.GestureRecognizers>
                        <Image Grid.Row="0" Grid.Column="0" Source="menu_settings" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center">
                            <Image.Behaviors><views:ThemedIconTint ThemeColorKey="OnSurfaceColor" /></Image.Behaviors>
                        </Image>
                        <Label Grid.Row="0" Grid.Column="1" Text="Edit panels" TextColor="{DynamicResource OnSurfaceColor}" FontSize="18"/>
                    </Grid>

                    <!--
                    <BoxView Grid.Row="1" BackgroundColor="{DynamicResource DividerColor}" HeightRequest="1" />


                    <Grid Grid.Row="2" RowDefinitions="30,30,30,30" ColumnSpacing="0" ColumnDefinitions="60,*">
                        <views:SettingsSwitch x:Name="ImperialSwitch" VerticalOptions="Center" Grid.Row="0" Grid.Column="0" IsToggledChanged="ImperialSwitch_IsToggledChanged" HorizontalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="1" VerticalOptions="Center" Text="Imperial units (mph, F)" TextColor="{Binding Source={x:Reference ImperialSwitch}, Path=CurrentColor}" FontSize="18" />

                        <views:SettingsSwitch Grid.Row="1" Grid.Column="0" VerticalOptions="Center" />
                        <Label Grid.Row="1" Grid.Column="1" Text="Light theme" TextColor="{DynamicResource OnSurfaceColor}" FontSize="18" VerticalOptions="Center" />

                        <views:SettingsSwitch Grid.Row="2" Grid.Column="0" VerticalOptions="Center" />
                        <Label Grid.Row="2" Grid.Column="1" Text="Board lights on" TextColor="{DynamicResource OnSurfaceColor}" FontSize="18" VerticalOptions="Center" />
                    
                        <views:SettingsSwitch Grid.Row="3" Grid.Column="0" VerticalOptions="Center" />
                        <Label Grid.Row="3" Grid.Column="1" Text="Show battery % calculation from voltage" TextColor="{DynamicResource OnSurfaceColor}" FontSize="18" />

                        <BoxView Color="White" Opacity="0.8" Grid.Row="1" Grid.Column="0" Grid.RowSpan="4" Grid.ColumnSpan="2" />
                        <Label TextColor="{DynamicResource OnSurfaceColor}" Grid.Row="1" Text="Coming Soon" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="0" Grid.RowSpan="4" Grid.ColumnSpan="2" FontAttributes="Bold" />
                    </Grid>

                    <BoxView Grid.Row="3" BackgroundColor="{DynamicResource DividerColor}" HeightRequest="1" />
                    -->

                    <Grid Grid.Row="4" VerticalOptions="End" RowDefinitions="Auto" ColumnSpacing="0" ColumnDefinitions="60,*">

                        <Image Grid.Row="0" Grid.Column="0" Source="settings_disconnect" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center">
<Image.Behaviors><views:ThemedIconTint ThemeColorKey="OnSurfaceColor" /></Image.Behaviors>
</Image>
                        <Label Grid.Row="0" Grid.Column="1" Text="Disconnect from board" TextColor="{DynamicResource OnSurfaceColor}" FontSize="18">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Disconnect_Tapped" />
                            </Label.GestureRecognizers>
                        </Label>


                    </Grid>
                </Grid>
            </DataTemplate>

        </ResourceDictionary>
    </pages:BaseContentPage.Resources>

    <!--
    <pages:BaseContentPage.Resources>
        
        <rgpopup:PopupPage x:Key="SettingsPopupPage" x:Name="SettingsPopupPage">
            <rgpopup:PopupPage.Animation>
                <rgpopupanimation:ScaleAnimation 
                    PositionIn="Bottom"
                    PositionOut="Bottom"
                    DurationIn="200"
                    DurationOut="200"
                    EasingIn="SinOut"
                    EasingOut="SinIn"
                    HasBackgroundAnimation="True"/>
            </rgpopup:PopupPage.Animation>

            
        </rgpopup:PopupPage>
    </pages:BaseContentPage.Resources>
    -->

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{DynamicResource BackgroundGradientStart}" Offset="0"/>
                <GradientStop Color="{DynamicResource BackgroundGradientEnd}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <StackLayout Spacing="16" Margin="0,16,0,0">
                <!-- The panels are created here, with their bindings, and then handed to the PanelBoard (see SetupPanels),
                     which lets the user move and resize them. This container is never shown. -->
                <VerticalStackLayout x:Name="PanelSource" IsVisible="False">
                    <views:SpeedRangeDistanceView x:Name="SpeedRangeDistanceView" HeightRequest="180" RPM="{Binding RPM}" WheelCircumference="{Binding WheelCircumference}" LifetimeOdometer="{Binding LifetimeOdometer}" TripOdometer="{Binding TripOdometer}" />
                    <views:BatteryPowerView x:Name="BatteryPowerPanel" BindingContext="{Binding .}" />
                    <views:TemperatureView x:Name="TemperatureView" BindingContext="{Binding .}" ControllerTemp="{Binding ControllerTemperature}" MotorTemp="{Binding MotorTemperature}" BatteryTemp="{Binding BatteryTemperature}" />
                    <views:RideModeView x:Name="RideModePanel" BindingContext="{Binding .}" BoardType="{Binding BoardType}" SimpleStopEnabled="{Binding SimpleStopEnabled}" />
                    <views:LightsView x:Name="LightsPanel" BindingContext="{Binding .}" />
                </VerticalStackLayout>
                <views:PanelBoard x:Name="Panels" />
                <!--
                These are removed for now to make way for bluetooth subscription limits on Android.
                They may come back later in the way of a diagnostics screen.
                <views:AngleView IsVisible="false" BindingContext="{Binding .}" Pitch="{Binding Pitch}" Yaw="{Binding Yaw}" Roll="{Binding Roll}"   />
                <views:FootpadsView IsVisible="false" />
                -->
                <Grid Padding="20,0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                    <Label Grid.Row="0" Grid.Column="0" Text="Serial number" FontFamily="SairaExtraCondensed-SemiBold" FontSize="16" TextColor="{DynamicResource MutedTextColor}" />
                    <Label Grid.Row="1" Grid.Column="0" Text="Battery serial number" FontFamily="SairaExtraCondensed-SemiBold" FontSize="16" TextColor="{DynamicResource MutedTextColor}" />
                    <Label Grid.Row="2" Grid.Column="0" Text="Hardware revision" FontFamily="SairaExtraCondensed-SemiBold" FontSize="16" TextColor="{DynamicResource MutedTextColor}" />
                    <Label Grid.Row="3" Grid.Column="0" Text="Firmware" FontFamily="SairaExtraCondensed-SemiBold" FontSize="16" TextColor="{DynamicResource MutedTextColor}" />
                    <Label Grid.Row="4" Grid.Column="0" Text="RSSI" FontFamily="SairaExtraCondensed-SemiBold" FontSize="16" TextColor="{DynamicResource MutedTextColor}" />
                    <Label Grid.Row="5" Grid.Column="0" Text="App Version" FontFamily="SairaExtraCondensed-SemiBold" FontSize="16" TextColor="{DynamicResource MutedTextColor}" />

                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding SerialNumber}" FontFamily="SairaExtraCondensed-SemiBold" FontSize="16" TextColor="{DynamicResource MutedTextColor}" HorizontalOptions="End" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding BatterySerial}" FontFamily="SairaExtraCondensed-SemiBold" FontSize="16" TextColor="{DynamicResource MutedTextColor}" HorizontalOptions="End" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding HardwareRevision}" FontFamily="SairaExtraCondensed-SemiBold" FontSize="16" TextColor="{DynamicResource MutedTextColor}" HorizontalOptions="End" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding FirmwareRevision}" FontFamily="SairaExtraCondensed-SemiBold" FontSize="16" TextColor="{DynamicResource MutedTextColor}" HorizontalOptions="End" />
                    <Label Grid.Row="4" Grid.Column="1" Text="{Binding RSSI}" FontFamily="SairaExtraCondensed-SemiBold" FontSize="16" TextColor="{DynamicResource MutedTextColor}" HorizontalOptions="End" />
                    <Label Grid.Row="5" Grid.Column="1" x:Name="AppVersionLabel" FontFamily="SairaExtraCondensed-SemiBold" FontSize="16" TextColor="{DynamicResource MutedTextColor}" HorizontalOptions="End" />
                </Grid>
            </StackLayout>
        </ScrollView>
    </Grid>
</pages:BaseContentPage>

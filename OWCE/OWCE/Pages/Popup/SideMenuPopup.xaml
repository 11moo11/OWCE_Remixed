<?xml version="1.0" encoding="UTF-8" ?>
<rgpopup:PopupPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:rgpopup="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:rgpopupanimation="clr-namespace:Mopups.Animations;assembly=Mopups"
    x:Class="OWCE.Pages.Popup.SideMenuPopup"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:popup="clr-namespace:OWCE.Pages.Popup"
    x:DataType="popup:SideMenuPopup"
    >


    <rgpopup:PopupPage.Animation>
        <rgpopupanimation:ScaleAnimation 
            PositionIn="Left"
            PositionOut="Left"
            DurationIn="200"
            DurationOut="200"
            EasingIn="SinOut"
            EasingOut="SinIn"
            ScaleIn="1"
            ScaleOut="1"
            HasBackgroundAnimation="True"/>
    </rgpopup:PopupPage.Animation>

    <Grid
          x:Name="MainGrid"
          BackgroundColor="White"
          HorizontalOptions="Fill"
          MaximumWidthRequest="500"
          ColumnSpacing="0"
          RowSpacing="12"
          Padding="0,16,0,16"
          Margin="0,0,40,0"
          RowDefinitions="Auto,1,*,1,Auto,Auto">

        <Label Grid.Row="0" Text="{Binding Title}" TextColor="Black" FontAttributes="Bold" FontSize="24" Padding="16,0,16,0" />



        <!-- Close button. The touch area is bigger than the 16 unit icon so it is easy to hit. -->
        <Grid Grid.Row="0" WidthRequest="44" HeightRequest="44" HorizontalOptions="End" VerticalOptions="Center" Margin="0,-12,4,-12" BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseCommand}" />
            </Grid.GestureRecognizers>
            <Image Source="menu_cancel" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True">
                <Image.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="Black" />
                </Image.Behaviors>
            </Image>
        </Grid>

        <BoxView Grid.Row="1" Background="#E4E4E4" HeightRequest="1" />

        <!-- Grid.Row 2 is for page specific menu -->

        <BoxView Grid.Row="3" Background="#E4E4E4" HeightRequest="1" />

        <Grid x:Name="SettingsRow" Grid.Row="4" RowDefinitions="Auto" ColumnDefinitions="60,*" ColumnSpacing="0">
<Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SettingsCommand}" CommandParameter="{x:Reference SettingsRow}" /></Grid.GestureRecognizers>
            <Image Grid.Row="0" Grid.Column="0" Source="menu_settings" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center">
<Image.Behaviors><toolkit:IconTintColorBehavior TintColor="Black" /></Image.Behaviors>
</Image>
            <Label Grid.Row="0" Grid.Column="1" Text="Settings" TextColor="Black" FontSize="18" />
        </Grid>

        <Grid x:Name="AboutRow" Grid.Row="5" RowDefinitions="Auto" ColumnDefinitions="60,*" ColumnSpacing="0">
<Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding AboutCommand}" CommandParameter="{x:Reference AboutRow}" /></Grid.GestureRecognizers>
            <Image Grid.Row="0" Grid.Column="0" Source="settings_info" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"/>
            <Label Grid.Row="0" Grid.Column="1" Text="About this app" TextColor="Black" FontSize="18" />
        </Grid>


    </Grid>

</rgpopup:PopupPage>
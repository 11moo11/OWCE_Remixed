<?xml version="1.0" encoding="UTF-8" ?>
<rgpopup:PopupPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:rgpopup="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:rgpopupanimation="clr-namespace:Mopups.Animations;assembly=Mopups"
    x:Class="OWCE.Pages.Popup.SideMenuPopup"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:popup="clr-namespace:OWCE.Pages.Popup"
    xmlns:views="clr-namespace:OWCE.Views"
    x:DataType="popup:SideMenuPopup"
    >


    <rgpopup:PopupPage.Animation>
        <rgpopupanimation:ScaleAnimation 
            PositionIn="Left"
            PositionOut="Left"
            DurationIn="200"
            DurationOut="200"
            EasingIn="SinOut"
            EasingOut="SinIn"
            ScaleIn="1"
            ScaleOut="1"
            HasBackgroundAnimation="True"/>
    </rgpopup:PopupPage.Animation>

    <!-- A navigation drawer: rounded on the side that meets the screen. -->
    <Border StrokeThickness="0"
            BackgroundColor="{DynamicResource SurfaceColor}"
            HorizontalOptions="Fill"
            MaximumWidthRequest="500"
            Margin="0,0,56,0">
    <Border.StrokeShape>
        <RoundRectangle CornerRadius="0,28,0,28" />
    </Border.StrokeShape>
    <Grid
          x:Name="MainGrid"
          ColumnSpacing="0"
          RowSpacing="0"
          Padding="0,24,0,20"
          RowDefinitions="Auto,*,Auto">

        <!-- Header: app name + a big round close button (easy to hit with a gloved or shaky thumb). -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="24,0,16,12">
            <Label Grid.Column="0" Text="{Binding Title}" TextColor="{DynamicResource OnSurfaceColor}" FontAttributes="Bold" FontSize="30" VerticalOptions="Center" />

            <Grid Grid.Column="1" WidthRequest="52" HeightRequest="52" VerticalOptions="Center" BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseCommand}" />
                </Grid.GestureRecognizers>
                <Border StrokeThickness="0" BackgroundColor="Transparent" InputTransparent="True">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>
                    <BoxView BackgroundColor="{DynamicResource AccentColor}" Opacity="0.14" InputTransparent="True" />
                </Border>
                <Image Source="menu_cancel" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True">
                    <Image.Behaviors>
                        <views:ThemedIconTint ThemeColorKey="OnSurfaceColor" />
                    </Image.Behaviors>
                </Image>
            </Grid>
        </Grid>

        <!-- Grid.Row 1 is for the page specific menu -->

        <VerticalStackLayout Grid.Row="2" Padding="16,16,16,0" Spacing="10">
            <views:MenuButton x:Name="SettingsButton" Text="Settings" IconSource="menu_settings"
                              Command="{Binding SettingsCommand}" CommandParameter="{x:Reference SettingsButton}" />
            <views:MenuButton x:Name="AboutButton" Text="About this app" IconSource="settings_info"
                              Command="{Binding AboutCommand}" CommandParameter="{x:Reference AboutButton}" />
        </VerticalStackLayout>

    </Grid>
    </Border>

</rgpopup:PopupPage>
<?xml version="1.0" encoding="UTF-8" ?>
<!-- City Escape: Inspired by Sonic Adventure 2: black and yellow with hero blue and rival red. Every theme defines the same keys, see ThemeManager. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="OWCE.Themes.CityEscapeTheme">

    <Color x:Key="BackgroundGradientStart">#101010</Color>
    <Color x:Key="BackgroundGradientEnd">#1B1B1B</Color>
    <Color x:Key="OnBackgroundColor">#FFD500</Color>
    <SolidColorBrush x:Key="OnBackgroundBrush" Color="#FFD500" />
    <Color x:Key="SurfaceColor">#1B1B1B</Color>
    <Color x:Key="OnSurfaceColor">#FFFFFF</Color>
    <Color x:Key="MutedTextColor">#BDBDBD</Color>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#BDBDBD" />
    <Color x:Key="DividerColor">#3A3A3A</Color>
    <!-- A brush version of DividerColor, for properties such as Border.Stroke that need a brush. -->
    <SolidColorBrush x:Key="DividerBrush" Color="#3A3A3A" />
    <Color x:Key="ScrimColor">#D9000000</Color>
    <Color x:Key="CardColor">#FFD500</Color>
    <Color x:Key="OnCardColor">#101010</Color>
    <Color x:Key="ButtonColor">#1B1B1B</Color>
    <Color x:Key="OnButtonColor">#FFD500</Color>
    <Color x:Key="ButtonBorderColor">#FFD500</Color>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFD500" />
    <Color x:Key="SelectedButtonColor">#FFD500</Color>
    <Color x:Key="OnSelectedButtonColor">#101010</Color>
    <Color x:Key="SliderActiveColor">#FFD500</Color>
    <Color x:Key="SliderInactiveColor">#3A3A3A</Color>
    <Color x:Key="SpeedPanel">#0A5BD8</Color>
    <Color x:Key="OnSpeedPanel">#FFFFFF</Color>
    <Color x:Key="BatteryPanel">#1B1B1B</Color>
    <Color x:Key="BatteryHeader">#9E0F18</Color>
    <Color x:Key="BatteryBar">#C4161F</Color>
    <Color x:Key="OnBattery">#FFFFFF</Color>
    <Color x:Key="PowerPanel">#FFD500</Color>
    <Color x:Key="PowerBar">#E6BF00</Color>
    <Color x:Key="OnPower">#101010</Color>
    <Color x:Key="TempPanel">#F2F2F2</Color>
    <Color x:Key="TempTrack">#DADADA</Color>
    <Color x:Key="TempBar">#A9C4F5</Color>
    <Color x:Key="OnTemp">#101010</Color>
    <Color x:Key="RideModePanel">#000000</Color>
    <Color x:Key="OnRideModePanel">#FFD500</Color>
    <Color x:Key="LightsPanel">#C4161F</Color>
    <Color x:Key="OnLights">#FFFFFF</Color>
    <SolidColorBrush x:Key="OnLightsBrush" Color="#FFFFFF" />
    <Color x:Key="MenuButtonColor">#FFD500</Color>
    <Color x:Key="OnMenuButtonColor">#101010</Color>
    <Color x:Key="CardSurfaceColor">#242424</Color>
    <Color x:Key="AccentColor">#FFD500</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#FFD500" />
    <Color x:Key="OnAccentColor">#101010</Color>

    <!-- The panels on the board screen. -->
    <Style x:Key="BoardDetailBlockBaseStyle" TargetType="Border">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="4" />
        </Setter>
        <Setter Property="Stroke" Value="#FFD500" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Shadow">
            <Shadow Brush="#000000" Opacity="0.6" Offset="0,3" Radius="6" />
        </Setter>
    </Style>

    <Style x:Key="RoundButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ButtonColor}" />
        <Setter Property="TextColor" Value="{DynamicResource OnButtonColor}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{DynamicResource ButtonBorderColor}" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="CharacterSpacing" Value="0.29" />
    </Style>

    <Style x:Key="SelectedRoundButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource SelectedButtonColor}" />
        <Setter Property="TextColor" Value="{DynamicResource OnSelectedButtonColor}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{DynamicResource ButtonBorderColor}" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="CharacterSpacing" Value="0.29" />
    </Style>

</ResourceDictionary>

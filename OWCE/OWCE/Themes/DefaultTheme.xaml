<?xml version="1.0" encoding="UTF-8" ?>
<!-- Default: The original OWCE look. Every theme defines the same keys, see ThemeManager. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="OWCE.Themes.DefaultTheme">

    <Color x:Key="BackgroundGradientStart">#E6E6E6</Color>
    <Color x:Key="BackgroundGradientEnd">#EEEEEE</Color>
    <Color x:Key="OnBackgroundColor">#000000</Color>
    <SolidColorBrush x:Key="OnBackgroundBrush" Color="#000000" />
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="OnSurfaceColor">#000000</Color>
    <Color x:Key="MutedTextColor">#7F7F7F</Color>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#7F7F7F" />
    <Color x:Key="DividerColor">#E4E4E4</Color>
    <!-- A brush version of DividerColor, for properties such as Border.Stroke that need a brush. -->
    <SolidColorBrush x:Key="DividerBrush" Color="#E4E4E4" />
    <Color x:Key="ScrimColor">#BF000000</Color>
    <Color x:Key="CardColor">#ECEC00</Color>
    <Color x:Key="OnCardColor">#000000</Color>
    <Color x:Key="ButtonColor">#FFFFFF</Color>
    <Color x:Key="OnButtonColor">#000000</Color>
    <Color x:Key="ButtonBorderColor">#DBDBDF</Color>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#DBDBDF" />
    <Color x:Key="SelectedButtonColor">#000000</Color>
    <Color x:Key="OnSelectedButtonColor">#FFFFFF</Color>
    <Color x:Key="SliderActiveColor">#000000</Color>
    <Color x:Key="SliderInactiveColor">#D0D0D0</Color>
    <Color x:Key="SpeedPanel">#FFFF00</Color>
    <Color x:Key="OnSpeedPanel">#000000</Color>
    <Color x:Key="BatteryPanel">#FFFF00</Color>
    <Color x:Key="BatteryHeader">#CC00CC</Color>
    <Color x:Key="BatteryBar">#FF00FF</Color>
    <Color x:Key="OnBattery">#FFFFFF</Color>
    <Color x:Key="PowerPanel">#7F01FF</Color>
    <Color x:Key="PowerBar">#6601CC</Color>
    <Color x:Key="OnPower">#FFFFFF</Color>
    <Color x:Key="TempPanel">#00FFFF</Color>
    <Color x:Key="TempTrack">#00CCCC</Color>
    <Color x:Key="TempBar">#00B3B3</Color>
    <Color x:Key="OnTemp">#000000</Color>
    <Color x:Key="RideModePanel">#000000</Color>
    <Color x:Key="OnRideModePanel">#FFFFFF</Color>
    <Color x:Key="LightsPanel">#FF8C00</Color>
    <Color x:Key="OnLights">#000000</Color>
    <Color x:Key="MenuButtonColor">#0000FF</Color>
    <Color x:Key="OnMenuButtonColor">#FFFFFF</Color>
    <Color x:Key="CardSurfaceColor">#FFFFFF</Color>
    <Color x:Key="AccentColor">#1F4FD8</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#1F4FD8" />
    <Color x:Key="OnAccentColor">#FFFFFF</Color>

    <!-- The panels on the board screen. -->
    <Style x:Key="BoardDetailBlockBaseStyle" TargetType="Border">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="11" />
        </Setter>
        <Setter Property="Stroke" Value="#00000000" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Shadow">
            <Shadow Brush="#000000" Opacity="0.14" Offset="0,1" Radius="9" />
        </Setter>
    </Style>

    <Style x:Key="RoundButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ButtonColor}" />
        <Setter Property="TextColor" Value="{DynamicResource OnButtonColor}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontFamily" Value="SairaExtraCondensed-Bold" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{DynamicResource ButtonBorderColor}" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="CharacterSpacing" Value="0.29" />
    </Style>

    <Style x:Key="SelectedRoundButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource SelectedButtonColor}" />
        <Setter Property="TextColor" Value="{DynamicResource OnSelectedButtonColor}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontFamily" Value="SairaExtraCondensed-Bold" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{DynamicResource ButtonBorderColor}" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="CharacterSpacing" Value="0.29" />
    </Style>

</ResourceDictionary>

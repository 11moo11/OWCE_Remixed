<?xml version="1.0" encoding="UTF-8" ?>
<!-- Material: Material Design 3 (baseline purple), tonal surfaces and large rounded corners. Every theme defines the same keys, see ThemeManager. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="OWCE.Themes.MaterialTheme">

    <Color x:Key="BackgroundGradientStart">#FEF7FF</Color>
    <Color x:Key="BackgroundGradientEnd">#F3EDF7</Color>
    <Color x:Key="OnBackgroundColor">#1D1B20</Color>
    <SolidColorBrush x:Key="OnBackgroundBrush" Color="#1D1B20" />
    <Color x:Key="SurfaceColor">#FFFBFE</Color>
    <Color x:Key="OnSurfaceColor">#1D1B20</Color>
    <Color x:Key="MutedTextColor">#49454F</Color>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#49454F" />
    <Color x:Key="DividerColor">#CAC4D0</Color>
    <!-- A brush version of DividerColor, for properties such as Border.Stroke that need a brush. -->
    <SolidColorBrush x:Key="DividerBrush" Color="#CAC4D0" />
    <Color x:Key="ScrimColor">#52000000</Color>
    <Color x:Key="CardColor">#E8DEF8</Color>
    <Color x:Key="OnCardColor">#1D192B</Color>
    <Color x:Key="ButtonColor">#E8DEF8</Color>
    <Color x:Key="OnButtonColor">#1D192B</Color>
    <Color x:Key="ButtonBorderColor">#79747E</Color>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#79747E" />
    <Color x:Key="SelectedButtonColor">#6750A4</Color>
    <Color x:Key="OnSelectedButtonColor">#FFFFFF</Color>
    <Color x:Key="SliderActiveColor">#6750A4</Color>
    <Color x:Key="SliderInactiveColor">#E6E0E9</Color>
    <Color x:Key="SpeedPanel">#EADDFF</Color>
    <Color x:Key="OnSpeedPanel">#21005D</Color>
    <Color x:Key="BatteryPanel">#E8DEF8</Color>
    <Color x:Key="BatteryHeader">#4F378B</Color>
    <Color x:Key="BatteryBar">#6750A4</Color>
    <Color x:Key="OnBattery">#FFFFFF</Color>
    <Color x:Key="PowerPanel">#7D5260</Color>
    <Color x:Key="PowerBar">#633B48</Color>
    <Color x:Key="OnPower">#FFFFFF</Color>
    <Color x:Key="TempPanel">#FFD8E4</Color>
    <Color x:Key="TempTrack">#F6C6D6</Color>
    <Color x:Key="TempBar">#EFB8C8</Color>
    <Color x:Key="OnTemp">#31111D</Color>
    <Color x:Key="RideModePanel">#322F35</Color>
    <Color x:Key="OnRideModePanel">#F5EFF7</Color>
    <Color x:Key="LightsPanel">#625B71</Color>
    <Color x:Key="OnLights">#FFFFFF</Color>
    <SolidColorBrush x:Key="OnLightsBrush" Color="#FFFFFF" />
    <Color x:Key="MenuButtonColor">#6750A4</Color>
    <Color x:Key="OnMenuButtonColor">#FFFFFF</Color>
    <Color x:Key="CardSurfaceColor">#F3EDF7</Color>
    <Color x:Key="AccentColor">#6750A4</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#6750A4" />
    <Color x:Key="OnAccentColor">#FFFFFF</Color>

    <!-- The panels on the board screen. -->
    <Style x:Key="BoardDetailBlockBaseStyle" TargetType="Border">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="28" />
        </Setter>
        <Setter Property="Stroke" Value="#00000000" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Shadow">
            <Shadow Brush="#000000" Opacity="0.18" Offset="0,2" Radius="4" />
        </Setter>
    </Style>

    <Style x:Key="RoundButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ButtonColor}" />
        <Setter Property="TextColor" Value="{DynamicResource OnButtonColor}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{DynamicResource ButtonBorderColor}" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="CharacterSpacing" Value="0.29" />
    </Style>

    <Style x:Key="SelectedRoundButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource SelectedButtonColor}" />
        <Setter Property="TextColor" Value="{DynamicResource OnSelectedButtonColor}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{DynamicResource ButtonBorderColor}" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="CharacterSpacing" Value="0.29" />
    </Style>

</ResourceDictionary>

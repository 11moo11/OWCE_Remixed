<?xml version="1.0" encoding="UTF-8"?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:OWCE.Views"
    xmlns:converters="clr-namespace:OWCE.Converters"
    x:Class="OWCE.Views.BatteryView">

    <ContentView.Resources>
        <converters:AnyTrueMultiConverter x:Key="AnyTrueConverter" />
        <converters:IsBoardTypeConverter x:Key="IsBoardTypeConverter" />
    </ContentView.Resources>

    <Border x:Name="MainView" BackgroundColor="{DynamicResource BatteryPanel}" Style="{DynamicResource BoardDetailBlockBaseStyle}" >


        <toolkit:Expander x:Name="ExpanderView" HorizontalOptions="Fill" PropertyChanged="ExpanderView_PropertyChanged">
            <toolkit:Expander.IsEnabled>
                <MultiBinding Converter="{StaticResource AnyTrueConverter}">
                    <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="V1" />
                    <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="Plus" />
                    <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="XR" />
                    <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="Pint" />
                    <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="PintX" />
                </MultiBinding>
            </toolkit:Expander.IsEnabled>
            <toolkit:Expander.Header>
                <Grid BackgroundColor="{DynamicResource BatteryHeader}" RowDefinitions="121" AbsoluteLayout.LayoutFlags="WidthProportional" AbsoluteLayout.LayoutBounds="0,0,1,121">

                    <BoxView x:Name="BatteryBar" BackgroundColor="{DynamicResource BatteryBar}" VerticalOptions="Fill" HorizontalOptions="Start" WidthRequest="100" />


                    <Label Text="BATTERY" FontFamily="SairaExtraCondensed-Bold" TextColor="{DynamicResource OnBattery}" CharacterSpacing="0.26" FontSize="16" Margin="20,6,0,0" />
                    <Label Text="{Binding BatteryPercent, StringFormat='{0}%'}"  TextColor="{DynamicResource OnBattery}"  FontFamily="SairaExtraCondensed-Black" FontSize="80" HorizontalOptions="Center" VerticalOptions="Start"  />

                    <Label VerticalOptions="End" Margin="20,0" TextColor="{DynamicResource OnBattery}">
                        <Label.IsVisible>
                            <MultiBinding Converter="{StaticResource AnyTrueConverter}">
                                <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="V1" />
                                <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="Plus" />
                                <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="XR" />
                                <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="Pint" />
                                <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="PintX" />
                            </MultiBinding>
                        </Label.IsVisible>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding BatteryCells.LowestCellVoltage, StringFormat='{0:F2}-'}" FontSize="16" FontFamily="SairaExtraCondensed-Medium" />
                                <Span Text="{Binding BatteryCells.HighestCellVoltage, StringFormat='{0:F2}V'}" FontSize="16" FontFamily="SairaExtraCondensed-Medium" />
                                <Span Text=" cell voltages" FontSize="16" FontFamily="SairaExtraCondensed-Light" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Text="{Binding BatteryVoltage, StringFormat='{0:F2}V'}" TextColor="{DynamicResource OnBattery}" FontSize="16" FontFamily="SairaExtraCondensed-Medium" HorizontalTextAlignment="End" HorizontalOptions="Fill" VerticalOptions="End" Margin="20,0" >
                        <Label.IsVisible>
                            <MultiBinding Converter="{StaticResource AnyTrueConverter}">
                                <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="V1" />
                                <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="Plus" />
                                <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="XR" />
                                <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="Pint" />
                                <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="PintX" />
                            </MultiBinding>
                        </Label.IsVisible>
                    </Label>


                    <views:ExpanderArrowView x:Name="ExpanderArrow" ArrowColor="{DynamicResource OnBattery}" HorizontalOptions="End" Margin="17,13" >
                        <views:ExpanderArrowView.IsVisible>
                             <MultiBinding Converter="{StaticResource AnyTrueConverter}">
                                <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="V1" />
                                <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="Plus" />
                                <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="XR" />
                                <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="Pint" />
                                <Binding Path="BoardType" Converter="{StaticResource IsBoardTypeConverter}" ConverterParameter="PintX" />
                            </MultiBinding>
                        </views:ExpanderArrowView.IsVisible>
                     </views:ExpanderArrowView>

                </Grid>

            </toolkit:Expander.Header>

            <views:BatteryCellsView x:Name="BatteryCellsView" BindingContext="{Binding BatteryCells}" />

        </toolkit:Expander>
    </Border>
</ContentView>

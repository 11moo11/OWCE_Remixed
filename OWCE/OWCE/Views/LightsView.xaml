<?xml version="1.0" encoding="UTF-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:OWCE.Views"
             x:Class="OWCE.Views.LightsView">

    <Border BackgroundColor="#FF8C00" Style="{StaticResource BoardDetailBlockBaseStyle}">
        <VerticalStackLayout Spacing="0">

            <!-- Header: tap the left part to turn the lights on or off, tap the arrow for custom lights. -->
            <Grid BackgroundColor="#FF8C00" ColumnDefinitions="*,64" RowDefinitions="121">
                <Grid Grid.Column="0" Grid.ColumnSpan="2" RowDefinitions="121" InputTransparent="True">
                    <Label Text="LIGHTS" FontFamily="SairaExtraCondensed-Bold" TextColor="White" CharacterSpacing="0.26" FontSize="16" Margin="20,6,0,0" />

                    <Label Text="OFF" FontFamily="SairaExtraCondensed-Black" TextColor="White" FontSize="80" HorizontalOptions="Center" VerticalOptions="Start">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding LightMode}" Value="True">
                                <Setter Property="Text" Value="ON" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Label Text="Tap to turn on or off" FontFamily="SairaExtraCondensed-Light" TextColor="White" FontSize="16" VerticalOptions="End" Margin="20,0" />
                </Grid>

                <Grid Grid.Column="0" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTapped" />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid Grid.Column="1" BackgroundColor="Transparent" VerticalOptions="Start" HeightRequest="64">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnArrowTapped" />
                    </Grid.GestureRecognizers>
                    <views:ExpanderArrowView x:Name="ExpanderArrow" HorizontalOptions="End" VerticalOptions="Start" Margin="17,13" />
                </Grid>
            </Grid>

            <!-- Custom lights. The board only has white and red LEDs, so this mixes those two. -->
            <VerticalStackLayout x:Name="DetailsPanel" IsVisible="False" BackgroundColor="White" Padding="20,16,20,20" Spacing="16">

                <Label Text="Custom colours" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" />
                <Label Text="The board has white and red LEDs. Mix them for each end." FontFamily="SairaExtraCondensed-SemiBold" TextColor="#7F7F7F" FontSize="14" Margin="0,-12,0,0" />

            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Front white" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" />
                    <Label x:Name="FrontWhiteValueLabel" Grid.Column="1" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" />
                </Grid>
                <views:ThickSlider x:Name="FrontWhiteSlider" Minimum="0" Maximum="100" Value="0" MinimumTrackColor="Black" MaximumTrackColor="#D0D0D0" ThumbColor="Black" ValueChanged="Slider_ValueChanged" DragCompleted="MixerSlider_DragCompleted" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Front red" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" />
                    <Label x:Name="FrontRedValueLabel" Grid.Column="1" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" />
                </Grid>
                <views:ThickSlider x:Name="FrontRedSlider" Minimum="0" Maximum="100" Value="0" MinimumTrackColor="Black" MaximumTrackColor="#D0D0D0" ThumbColor="Black" ValueChanged="Slider_ValueChanged" DragCompleted="MixerSlider_DragCompleted" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Back white" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" />
                    <Label x:Name="BackWhiteValueLabel" Grid.Column="1" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" />
                </Grid>
                <views:ThickSlider x:Name="BackWhiteSlider" Minimum="0" Maximum="100" Value="0" MinimumTrackColor="Black" MaximumTrackColor="#D0D0D0" ThumbColor="Black" ValueChanged="Slider_ValueChanged" DragCompleted="MixerSlider_DragCompleted" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Back red" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" />
                    <Label x:Name="BackRedValueLabel" Grid.Column="1" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" />
                </Grid>
                <views:ThickSlider x:Name="BackRedSlider" Minimum="0" Maximum="100" Value="0" MinimumTrackColor="Black" MaximumTrackColor="#D0D0D0" ThumbColor="Black" ValueChanged="Slider_ValueChanged" DragCompleted="MixerSlider_DragCompleted" />
            </VerticalStackLayout>

                <Label Text="Effects" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" Margin="0,8,0,0" />

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never" HeightRequest="60">
                    <HorizontalStackLayout Spacing="0">
                        <Button x:Name="BreatheButton" Text="Breathe" Style="{StaticResource RoundButtonStyle}" Margin="0,0,10,0" Clicked="EffectButton_Clicked" />
                        <Button x:Name="FadeButton" Text="Fade" Style="{StaticResource RoundButtonStyle}" Margin="0,0,10,0" Clicked="EffectButton_Clicked" />
                        <Button x:Name="SwapButton" Text="Swap" Style="{StaticResource RoundButtonStyle}" Margin="0,0,10,0" Clicked="EffectButton_Clicked" />
                    </HorizontalStackLayout>
                </ScrollView>

            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Speed" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" />
                    <Label x:Name="SpeedValueLabel" Grid.Column="1" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" />
                </Grid>
                <views:ThickSlider x:Name="SpeedSlider" Minimum="1" Maximum="10" Value="5" MinimumTrackColor="Black" MaximumTrackColor="#D0D0D0" ThumbColor="Black" ValueChanged="Slider_ValueChanged"  />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Brightness" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" />
                    <Label x:Name="BrightnessValueLabel" Grid.Column="1" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" />
                </Grid>
                <views:ThickSlider x:Name="BrightnessSlider" Minimum="10" Maximum="100" Value="60" MinimumTrackColor="Black" MaximumTrackColor="#D0D0D0" ThumbColor="Black" ValueChanged="Slider_ValueChanged"  />
            </VerticalStackLayout>

                <Button Text="Reset to default lights" Style="{StaticResource RoundButtonStyle}" HorizontalOptions="Center" Margin="0,8,0,0" Clicked="ResetButton_Clicked" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>

</ContentView>

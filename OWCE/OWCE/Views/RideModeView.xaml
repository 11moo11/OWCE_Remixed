<?xml version="1.0" encoding="UTF-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="OWCE.Views.RideModeView"
             xmlns:views="clr-namespace:OWCE.Views"
             xmlns:converters="clr-namespace:OWCE.Converters">

    <ContentView.Resources>
        <converters:AllTrueMultiConverter x:Key="AllTrueConverter" />
        <converters:AnyTrueMultiConverter x:Key="AnyTrueConverter" />
        <converters:IsBoardTypeConverter x:Key="IsBoardTypeConverter" />
        <converters:IsTrueConverter x:Key="IsTrueConverter" />
        <converters:IsFalseConverter x:Key="IsFalseConverter" />
        <converters:SelectedButtonConverter x:Key="SelectedButtonConverter" />
    </ContentView.Resources>

    <Border BackgroundColor="#000000" Style="{StaticResource BoardDetailBlockBaseStyle}">
        <toolkit:Expander x:Name="ExpanderView" Margin="0" Padding="0" HorizontalOptions="Fill" PropertyChanged="ExpanderView_PropertyChanged">
            <toolkit:Expander.Header>
                <Grid BackgroundColor="#000000"  AbsoluteLayout.LayoutFlags="WidthProportional" AbsoluteLayout.LayoutBounds="0,0,1,121">
                    <Label Text="RIDE MODE" FontFamily="SairaExtraCondensed-Bold" TextColor="White" CharacterSpacing="0.26" FontSize="16" Margin="20,6,0,0" />

                    <Label Text="{Binding RideModeString}" FontFamily="SairaExtraCondensed-Black" HorizontalOptions="Center" TextColor="White" CharacterSpacing="2.2" FontSize="60" Padding="0,16,0,16" />


                    <!--
                    <Label Text="Simplestop is ON" IsVisible="{Binding SimpleStopEnabled, Converter={StaticResource IsTrueConverter}}" FontFamily="SairaExtraCondensed-SemiBold" TextColor="Magenta" HorizontalOptions="Center" VerticalOptions="End" FontSize="16" Margin="0,0,0,6" />
                    <Label Text="Simplestop is OFF" IsVisible="{Binding SimpleStopEnabled, Converter={StaticResource IsFalseConverter}}" FontFamily="SairaExtraCondensed-SemiBold" TextColor="White" HorizontalOptions="Center" VerticalOptions="End" FontSize="16" Margin="0,0,0,6" />
                    -->

                    <views:ExpanderArrowView x:Name="ExpanderArrow" HorizontalOptions="End" Margin="17,13" />

                </Grid>
            </toolkit:Expander.Header>
            <Grid ColumnSpacing="0" RowSpacing="0" RowDefinitions="Auto,76,Auto" Margin="0" Padding="0">
                <!--
                <views:SwitchView Grid.Row="0" HorizontalOptions="Center">
                    <views:SwitchView.IsVisible>
                        <MultiBinding Converter="{StaticResource AnyTrueConverter}">
                            <Binding Path="SimpleStopEnabled" Converter="{StaticResource IsTrueConverter}" />
                            <Binding Path="SimpleStopEnabled" Converter="{StaticResource IsFalseConverter}" />
                        </MultiBinding>
                    </views:SwitchView.IsVisible>
                </views:SwitchView>
                -->

                <!--
                <CollectionView x:Name="RideModesCollectionView" HorizontalScrollBarVisibility="Never" ItemsLayout="HorizontalList" Grid.Row="1" HeightRequest="76" BackgroundColor="White">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="views:RideModeButton">
                            <Grid>
                                <Button Text="{Binding Name}" Clicked="RideModeButton_Clicked" Style="{Binding IsSelected, Converter={StaticResource SelectedButtonConverter}}">
                                    
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                -->

                <ScrollView Grid.Row="1" HeightRequest="76" BackgroundColor="White" HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never" Orientation="Horizontal">
                    <StackLayout  x:Name="RideModesStackLayout" BindableLayout.ItemsSource="{Binding User.TopFollowers}" Grid.Row="1" HeightRequest="76" BackgroundColor="White" Orientation="Horizontal">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="views:RideModeButton">
                                <Button Text="{Binding Name}" Clicked="RideModeButton_Clicked" Style="{Binding IsSelected, Converter={StaticResource SelectedButtonConverter}}" HorizontalOptions="Center">
                                    
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </ScrollView>
               

                <!-- Custom shaping. Only shown when the board supports it and is in Custom ride mode. -->
                <VerticalStackLayout x:Name="CustomShapingPanel" Grid.Row="2" IsVisible="False" Padding="20,16,20,20" Spacing="14" BackgroundColor="White">
                    <Label x:Name="CustomShapingStatusLabel" FontFamily="SairaExtraCondensed-SemiBold" TextColor="#7F7F7F" FontSize="16" />

                    <VerticalStackLayout x:Name="CustomShapingSliders" Spacing="12">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Aggressiveness" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" />
                            <Label x:Name="AggressivenessValueLabel" Grid.Column="1" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" />
                        </Grid>
                        <Slider x:Name="AggressivenessSlider" Minimum="0" Maximum="10" MinimumTrackColor="Black" MaximumTrackColor="#D0D0D0" ThumbColor="Black" ValueChanged="Slider_ValueChanged" DragCompleted="Slider_DragCompleted" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Turn compensation" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" />
                            <Label x:Name="TurnCompensationValueLabel" Grid.Column="1" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" />
                        </Grid>
                        <Slider x:Name="TurnCompensationSlider" Minimum="0" Maximum="10" MinimumTrackColor="Black" MaximumTrackColor="#D0D0D0" ThumbColor="Black" ValueChanged="Slider_ValueChanged" DragCompleted="Slider_DragCompleted" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Angle offset" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" />
                            <Label x:Name="AngleOffsetValueLabel" Grid.Column="1" FontFamily="SairaExtraCondensed-Bold" TextColor="Black" FontSize="18" CharacterSpacing="0.26" />
                        </Grid>
                        <Slider x:Name="AngleOffsetSlider" Minimum="-1.5" Maximum="3" MinimumTrackColor="Black" MaximumTrackColor="#D0D0D0" ThumbColor="Black" ValueChanged="Slider_ValueChanged" DragCompleted="Slider_DragCompleted" />
                    </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Button Text="Reload from board" Style="{StaticResource RoundButtonStyle}" HorizontalOptions="Center" Margin="0,4,0,0" Clicked="ReloadCustomShaping_Clicked" />
                </VerticalStackLayout>
            </Grid>
        </toolkit:Expander>
    </Border>
</ContentView>

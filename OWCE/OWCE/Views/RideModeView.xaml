<?xml version="1.0" encoding="UTF-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="OWCE.Views.RideModeView"
             xmlns:views="clr-namespace:OWCE.Views"
             xmlns:converters="clr-namespace:OWCE.Converters">

    <Border BackgroundColor="{DynamicResource RideModePanel}" Style="{DynamicResource BoardDetailBlockBaseStyle}">
        <VerticalStackLayout Spacing="0">

            <!-- The ride mode is chosen by swiping this part sideways (or tapping the arrows). -->
            <Grid x:Name="Header" HeightRequest="150" BackgroundColor="{DynamicResource RideModePanel}">
                <Label Text="RIDE MODE" Style="{StaticResource PanelCaptionStyle}" TextColor="{DynamicResource OnRideModePanel}" />

                <!-- Arrows and a hint at the top right, so it is clear that the mode is swiped. -->
                <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="Start" Margin="0,8,12,0" Spacing="2">
                    <Label x:Name="PreviousArrow" Text="‹" FontSize="34" Padding="10,0" TextColor="{DynamicResource OnRideModePanel}" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="PreviousArrow_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="SWIPE" FontSize="12" CharacterSpacing="2" FontAttributes="Bold" Opacity="0.7" TextColor="{DynamicResource OnRideModePanel}" VerticalOptions="Center" />
                    <Label x:Name="NextArrow" Text="›" FontSize="34" Padding="10,0" TextColor="{DynamicResource OnRideModePanel}" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="NextArrow_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <Grid x:Name="Stage" Margin="0,38,0,38" IsClippedToBounds="True">
                    <Label x:Name="ModeLabel" FontAttributes="Bold" Text="{Binding RideModeString}" HorizontalOptions="Start" VerticalOptions="Center" Margin="20,0" TextColor="{DynamicResource OnRideModePanel}" CharacterSpacing="0.5" FontSize="44" />
                </Grid>

                <!-- One dot per ride mode, the current one stretched. -->
                <HorizontalStackLayout x:Name="Dots" Spacing="6" HorizontalOptions="Start" VerticalOptions="End" Margin="20,0,20,16" />
            </Grid>

                <!-- Custom shaping. Only shown when the board supports it and is in Custom ride mode. -->
                <VerticalStackLayout x:Name="CustomShapingPanel" IsVisible="False" Padding="20,16,20,20" Spacing="14" BackgroundColor="{DynamicResource SurfaceColor}">
                    <Label x:Name="CustomShapingStatusLabel" TextColor="{DynamicResource MutedTextColor}" FontSize="16" />

                    <VerticalStackLayout x:Name="CustomShapingSliders" Spacing="12">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label FontAttributes="Bold" Text="Aggressiveness" TextColor="{DynamicResource OnSurfaceColor}" FontSize="18" CharacterSpacing="0.26" />
                            <Label FontAttributes="Bold" x:Name="AggressivenessValueLabel" Grid.Column="1" TextColor="{DynamicResource OnSurfaceColor}" FontSize="18" CharacterSpacing="0.26" />
                        </Grid>
                        <views:ThickSlider x:Name="AggressivenessSlider" Minimum="0" Maximum="10" MinimumTrackColor="{DynamicResource SliderActiveColor}" MaximumTrackColor="{DynamicResource SliderInactiveColor}" ThumbColor="{DynamicResource SliderActiveColor}" ValueChanged="Slider_ValueChanged" DragCompleted="Slider_DragCompleted" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label FontAttributes="Bold" Text="Turn compensation" TextColor="{DynamicResource OnSurfaceColor}" FontSize="18" CharacterSpacing="0.26" />
                            <Label FontAttributes="Bold" x:Name="TurnCompensationValueLabel" Grid.Column="1" TextColor="{DynamicResource OnSurfaceColor}" FontSize="18" CharacterSpacing="0.26" />
                        </Grid>
                        <views:ThickSlider x:Name="TurnCompensationSlider" Minimum="0" Maximum="10" MinimumTrackColor="{DynamicResource SliderActiveColor}" MaximumTrackColor="{DynamicResource SliderInactiveColor}" ThumbColor="{DynamicResource SliderActiveColor}" ValueChanged="Slider_ValueChanged" DragCompleted="Slider_DragCompleted" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label FontAttributes="Bold" Text="Angle offset" TextColor="{DynamicResource OnSurfaceColor}" FontSize="18" CharacterSpacing="0.26" />
                            <Label FontAttributes="Bold" x:Name="AngleOffsetValueLabel" Grid.Column="1" TextColor="{DynamicResource OnSurfaceColor}" FontSize="18" CharacterSpacing="0.26" />
                        </Grid>
                        <views:ThickSlider x:Name="AngleOffsetSlider" Minimum="-3" Maximum="1.5" MinimumTrackColor="{DynamicResource SliderActiveColor}" MaximumTrackColor="{DynamicResource SliderInactiveColor}" ThumbColor="{DynamicResource SliderActiveColor}" ValueChanged="Slider_ValueChanged" DragCompleted="Slider_DragCompleted" />
                    </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>


        </VerticalStackLayout>
    </Border>
</ContentView>

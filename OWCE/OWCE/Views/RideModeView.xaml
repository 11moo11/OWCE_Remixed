<?xml version="1.0" encoding="UTF-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="OWCE.Views.RideModeView"
             xmlns:views="clr-namespace:OWCE.Views"
             xmlns:converters="clr-namespace:OWCE.Converters">

    <ContentView.Resources>
        <converters:AllTrueMultiConverter x:Key="AllTrueConverter" />
        <converters:AnyTrueMultiConverter x:Key="AnyTrueConverter" />
        <converters:IsBoardTypeConverter x:Key="IsBoardTypeConverter" />
        <converters:IsTrueConverter x:Key="IsTrueConverter" />
        <converters:IsFalseConverter x:Key="IsFalseConverter" />
        <converters:SelectedButtonConverter x:Key="SelectedButtonConverter" />
    </ContentView.Resources>

    <Border BackgroundColor="{DynamicResource RideModePanel}" Style="{DynamicResource BoardDetailBlockBaseStyle}">
        <toolkit:Expander x:Name="ExpanderView" Margin="0" Padding="0" HorizontalOptions="Fill" PropertyChanged="ExpanderView_PropertyChanged">
            <toolkit:Expander.Header>
                <Grid BackgroundColor="{DynamicResource RideModePanel}"  AbsoluteLayout.LayoutFlags="WidthProportional" AbsoluteLayout.LayoutBounds="0,0,1,121">
                    <Label Text="RIDE MODE" Style="{StaticResource PanelCaptionStyle}" TextColor="{DynamicResource OnRideModePanel}" />

                    <Label FontAttributes="Bold" Text="{Binding RideModeString}" HorizontalOptions="Start" Margin="20,30,56,20" TextColor="{DynamicResource OnRideModePanel}" CharacterSpacing="0.5" FontSize="44" />


                    <!--
                    <Label Text="Simplestop is ON" IsVisible="{Binding SimpleStopEnabled, Converter={StaticResource IsTrueConverter}}" FontFamily="SairaExtraCondensed-SemiBold" TextColor="Magenta" HorizontalOptions="Center" VerticalOptions="End" FontSize="16" Margin="0,0,0,6" />
                    <Label Text="Simplestop is OFF" IsVisible="{Binding SimpleStopEnabled, Converter={StaticResource IsFalseConverter}}" FontFamily="SairaExtraCondensed-SemiBold" TextColor="{DynamicResource OnRideModePanel}" HorizontalOptions="Center" VerticalOptions="End" FontSize="16" Margin="0,0,0,6" />
                    -->

                    <views:ExpanderArrowView x:Name="ExpanderArrow" ArrowColor="{DynamicResource OnRideModePanel}" HorizontalOptions="End" Margin="17,13" />

                </Grid>
            </toolkit:Expander.Header>
            <Grid ColumnSpacing="0" RowSpacing="0" RowDefinitions="Auto,76,Auto" Margin="0" Padding="0">
                <!--
                <views:SwitchView Grid.Row="0" HorizontalOptions="Center">
                    <views:SwitchView.IsVisible>
                        <MultiBinding Converter="{StaticResource AnyTrueConverter}">
                            <Binding Path="SimpleStopEnabled" Converter="{StaticResource IsTrueConverter}" />
                            <Binding Path="SimpleStopEnabled" Converter="{StaticResource IsFalseConverter}" />
                        </MultiBinding>
                    </views:SwitchView.IsVisible>
                </views:SwitchView>
                -->

                <!--
                <CollectionView x:Name="RideModesCollectionView" HorizontalScrollBarVisibility="Never" ItemsLayout="HorizontalList" Grid.Row="1" HeightRequest="76" BackgroundColor="{DynamicResource SurfaceColor}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="views:RideModeButton">
                            <Grid>
                                <Button Text="{Binding Name}" Clicked="RideModeButton_Clicked" Style="{Binding IsSelected, Converter={StaticResource SelectedButtonConverter}}">
                                    
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                -->

                <ScrollView Grid.Row="1" HeightRequest="76" BackgroundColor="{DynamicResource SurfaceColor}" HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never" Orientation="Horizontal">
                    <StackLayout  x:Name="RideModesStackLayout" BindableLayout.ItemsSource="{Binding User.TopFollowers}" Grid.Row="1" HeightRequest="76" BackgroundColor="{DynamicResource SurfaceColor}" Orientation="Horizontal">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="views:RideModeButton">
                                <Button Text="{Binding Name}" Clicked="RideModeButton_Clicked" Style="{Binding IsSelected, Converter={StaticResource SelectedButtonConverter}}" HorizontalOptions="Center">
                                    
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </ScrollView>
               

                <!-- Custom shaping. Only shown when the board supports it and is in Custom ride mode. -->
                <VerticalStackLayout x:Name="CustomShapingPanel" Grid.Row="2" IsVisible="False" Padding="20,16,20,20" Spacing="14" BackgroundColor="{DynamicResource SurfaceColor}">
                    <Label x:Name="CustomShapingStatusLabel" TextColor="{DynamicResource MutedTextColor}" FontSize="16" />

                    <VerticalStackLayout x:Name="CustomShapingSliders" Spacing="12">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label FontAttributes="Bold" Text="Aggressiveness" TextColor="{DynamicResource OnSurfaceColor}" FontSize="18" CharacterSpacing="0.26" />
                            <Label FontAttributes="Bold" x:Name="AggressivenessValueLabel" Grid.Column="1" TextColor="{DynamicResource OnSurfaceColor}" FontSize="18" CharacterSpacing="0.26" />
                        </Grid>
                        <views:ThickSlider x:Name="AggressivenessSlider" Minimum="0" Maximum="10" MinimumTrackColor="{DynamicResource SliderActiveColor}" MaximumTrackColor="{DynamicResource SliderInactiveColor}" ThumbColor="{DynamicResource SliderActiveColor}" ValueChanged="Slider_ValueChanged" DragCompleted="Slider_DragCompleted" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label FontAttributes="Bold" Text="Turn compensation" TextColor="{DynamicResource OnSurfaceColor}" FontSize="18" CharacterSpacing="0.26" />
                            <Label FontAttributes="Bold" x:Name="TurnCompensationValueLabel" Grid.Column="1" TextColor="{DynamicResource OnSurfaceColor}" FontSize="18" CharacterSpacing="0.26" />
                        </Grid>
                        <views:ThickSlider x:Name="TurnCompensationSlider" Minimum="0" Maximum="10" MinimumTrackColor="{DynamicResource SliderActiveColor}" MaximumTrackColor="{DynamicResource SliderInactiveColor}" ThumbColor="{DynamicResource SliderActiveColor}" ValueChanged="Slider_ValueChanged" DragCompleted="Slider_DragCompleted" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label FontAttributes="Bold" Text="Angle offset" TextColor="{DynamicResource OnSurfaceColor}" FontSize="18" CharacterSpacing="0.26" />
                            <Label FontAttributes="Bold" x:Name="AngleOffsetValueLabel" Grid.Column="1" TextColor="{DynamicResource OnSurfaceColor}" FontSize="18" CharacterSpacing="0.26" />
                        </Grid>
                        <views:ThickSlider x:Name="AngleOffsetSlider" Minimum="-3" Maximum="1.5" MinimumTrackColor="{DynamicResource SliderActiveColor}" MaximumTrackColor="{DynamicResource SliderInactiveColor}" ThumbColor="{DynamicResource SliderActiveColor}" ValueChanged="Slider_ValueChanged" DragCompleted="Slider_DragCompleted" />
                    </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </Grid>
        </toolkit:Expander>
    </Border>
</ContentView>

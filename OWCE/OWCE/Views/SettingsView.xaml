<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:OWCE.Views"
    x:Class="OWCE.Views.SettingsView"
    x:DataType="views:SettingsView">

    <ScrollView>
        <VerticalStackLayout x:Name="ContentStack" Padding="16,0,16,32">

            <Label x:Name="TitleLabel" Text="Settings" FontSize="34" TextColor="{DynamicResource OnBackgroundColor}" Margin="20,12,20,20" />

            <Label Text="Appearance" Style="{StaticResource SectionHeaderStyle}" Margin="20,0,20,10" />
            <Border StrokeThickness="0" Padding="12,20,12,18" BackgroundColor="{DynamicResource CardSurfaceColor}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Presets" FontAttributes="Bold" FontSize="16" TextColor="{DynamicResource OnSurfaceColor}" Margin="8,0,8,0" />
                    <views:ThemePicker x:Name="ThemePicker" />

                    <VerticalStackLayout Spacing="10" Margin="8,10,8,0">
                        <Label Text="Mode" FontAttributes="Bold" FontSize="16" TextColor="{DynamicResource OnSurfaceColor}" />
                        <views:SegmentedControl x:Name="ModeControl" />

                        <Label Text="Colours" FontAttributes="Bold" FontSize="16" TextColor="{DynamicResource OnSurfaceColor}" Margin="0,10,0,0" />
                        <!-- Which of the three colours is being edited. Each shows its current colour. -->
                        <Grid x:Name="RoleRow" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4" />
                        <Label x:Name="RoleHintLabel" FontSize="13" TextColor="{DynamicResource MutedTextColor}" />
                        <Grid x:Name="SwatchGrid" ColumnDefinitions="*,*,*,*,*,*" RowSpacing="6" Margin="0,4,0,0" SizeChanged="SwatchGrid_SizeChanged" />

                        <!-- Only shown while the custom colour is the one selected. -->
                        <VerticalStackLayout x:Name="CustomControls" IsVisible="False" Spacing="6">
                        <!-- A rainbow bar with a see-through slider on top, for any other colour. -->
                        <Grid HeightRequest="44">
                            <Border x:Name="HueBar" StrokeThickness="0" HeightRequest="14" VerticalOptions="Center" Margin="12,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="7" />
                                </Border.StrokeShape>
                            </Border>
                            <Slider x:Name="HueSlider" Minimum="0" Maximum="360" MinimumTrackColor="Transparent" MaximumTrackColor="Transparent" ThumbColor="White" VerticalOptions="Center" ValueChanged="HueSlider_ValueChanged" DragCompleted="HueSlider_DragCompleted" />
                        </Grid>
                        <Slider x:Name="ShadeSlider" Minimum="0.15" Maximum="0.95" MinimumTrackColor="{DynamicResource AccentColor}" MaximumTrackColor="{DynamicResource DividerColor}" ThumbColor="{DynamicResource AccentColor}" ValueChanged="ShadeSlider_ValueChanged" DragCompleted="ShadeSlider_DragCompleted" />
                        </VerticalStackLayout>
                        <Button x:Name="ResetColoursButton" Text="Reset colours" Style="{StaticResource DialogButtonStyle}" Clicked="ResetColours_Clicked" IsVisible="False" />

                        <Label Text="Panel corners" FontAttributes="Bold" FontSize="16" TextColor="{DynamicResource OnSurfaceColor}" Margin="0,10,0,0" />
                        <views:SegmentedControl x:Name="CornersControl" />

                        <Label Text="Panel effect" FontAttributes="Bold" FontSize="16" TextColor="{DynamicResource OnSurfaceColor}" Margin="0,10,0,0" />
                        <views:SegmentedControl x:Name="DepthControl" />

                        <Label Text="Font" FontAttributes="Bold" FontSize="16" TextColor="{DynamicResource OnSurfaceColor}" Margin="0,10,0,0" />
                        <FlexLayout x:Name="FontChips" Wrap="Wrap" JustifyContent="Start" />

                        <views:MenuButton Margin="0,14,0,0" Text="Save as a new style" IconPathData="{x:Static views:Icons.Save}" Tapped="SaveStyle_Tapped" />

                        <!-- For a style you saved earlier. -->
                        <VerticalStackLayout x:Name="StyleActions" IsVisible="False" Spacing="10">
                            <views:MenuButton Text="Save changes to this style" IconPathData="{x:Static views:Icons.Save}" Tapped="UpdateStyle_Tapped" />
                            <views:MenuButton IsDanger="True" Text="Delete this style" IconPathData="{x:Static views:Icons.Delete}" Tapped="DeleteStyle_Tapped" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Units" Style="{StaticResource SectionHeaderStyle}" />
            <views:SettingsGroup>
                <views:SettingsItem Title="Imperial units" Subtitle="Show speed in mph and temperature in °F">
                    <Switch x:Name="ImperialSwitch" OnColor="{DynamicResource AccentColor}" Toggled="ImperialSwitch_Toggled" />
                </views:SettingsItem>
            </views:SettingsGroup>

            <Label Text="Rides" Style="{StaticResource SectionHeaderStyle}" />
            <views:SettingsGroup>
                <views:SettingsItem Title="Auto ride recording" Subtitle="Start recording a ride as soon as you connect to a board">
                    <Switch x:Name="AutoRecordSwitch" OnColor="{DynamicResource AccentColor}" Toggled="AutoRecordSwitch_Toggled" />
                </views:SettingsItem>
            </views:SettingsGroup>

            <Label Text="About" Style="{StaticResource SectionHeaderStyle}" Margin="20,32,20,10" />
            <Border StrokeThickness="0" Padding="20,18" BackgroundColor="{DynamicResource CardSurfaceColor}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label FontSize="16" TextColor="{DynamicResource OnSurfaceColor}" Text="This is a third party app made by the community, for the community. Its aim is to bring additional safety features &amp; better data reporting to its users." />
                    <Label FontSize="14" TextColor="{DynamicResource MutedTextColor}" Text="This is not the official Onewheel app. It is not supported, endorsed or affiliated with Future Motion in any way." />
                </VerticalStackLayout>
            </Border>

            <Label Text="App" Style="{StaticResource SectionHeaderStyle}" />
            <views:SettingsGroup>
                <views:SettingsItem Title="Version">
                    <Label Text="{Binding VersionString}" FontSize="16" TextColor="{DynamicResource MutedTextColor}" />
                </views:SettingsItem>
            </views:SettingsGroup>

            <Label Text="Help" Style="{StaticResource SectionHeaderStyle}" />
            <views:SettingsGroup>
                <views:SettingsItem Title="OWCE FAQ" ShowChevron="True" Command="{Binding FAQCommand}" />
                <views:SettingsItem Title="Report a problem" ShowChevron="True" Command="{Binding ReportProblemCommand}" />
                <views:SettingsItem Title="Request a feature" ShowChevron="True" Command="{Binding RequestFeatureCommand}" />
            </views:SettingsGroup>

            <Label Text="Community" Style="{StaticResource SectionHeaderStyle}" />
            <views:SettingsGroup>
                <views:SettingsItem Title="GitHub" Subtitle="Source code" ShowChevron="True" Command="{Binding SourceCodeCommand}" />
                <views:SettingsItem Title="Reddit" ShowChevron="True" Command="{Binding RedditCommand}" />
                <views:SettingsItem Title="Twitter" ShowChevron="True" Command="{Binding TwitterCommand}" />
                <views:SettingsItem Title="Facebook page" Subtitle="For news" ShowChevron="True" Command="{Binding FacebookPageCommand}" />
                <views:SettingsItem Title="Facebook group" Subtitle="For discussions" ShowChevron="True" Command="{Binding FacebookGroupCommand}" />
            </views:SettingsGroup>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>

<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:OWCE.Views"
    x:Class="OWCE.Views.SettingsView"
    x:DataType="views:SettingsView">

    <ScrollView>
        <VerticalStackLayout x:Name="ContentStack" Padding="16,0,16,32">

            <Label x:Name="TitleLabel" Text="Settings" FontSize="34" TextColor="{DynamicResource OnBackgroundColor}" Margin="20,12,20,20" />

            <Label Text="Appearance" Style="{StaticResource SectionHeaderStyle}" Margin="20,0,20,10" />
            <Border StrokeThickness="0" Padding="12,20,12,16" BackgroundColor="{DynamicResource CardSurfaceColor}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="18">
                    <views:ThemePicker x:Name="ThemePicker" />
                    <Label x:Name="ThemeDescriptionLabel" FontSize="14" HorizontalTextAlignment="Center" TextColor="{DynamicResource MutedTextColor}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Units" Style="{StaticResource SectionHeaderStyle}" />
            <views:SettingsGroup>
                <views:SettingsItem Title="Imperial units" Subtitle="Show speed in mph and temperature in °F">
                    <Switch x:Name="ImperialSwitch" OnColor="{DynamicResource AccentColor}" Toggled="ImperialSwitch_Toggled" />
                </views:SettingsItem>
            </views:SettingsGroup>

            <Label Text="Rides" Style="{StaticResource SectionHeaderStyle}" />
            <views:SettingsGroup>
                <views:SettingsItem Title="Auto ride recording" Subtitle="Start recording a ride as soon as you connect to a board">
                    <Switch x:Name="AutoRecordSwitch" OnColor="{DynamicResource AccentColor}" Toggled="AutoRecordSwitch_Toggled" />
                </views:SettingsItem>
            </views:SettingsGroup>

            <Label Text="About" Style="{StaticResource SectionHeaderStyle}" Margin="20,32,20,10" />
            <Border StrokeThickness="0" Padding="20,18" BackgroundColor="{DynamicResource CardSurfaceColor}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label FontSize="16" TextColor="{DynamicResource OnSurfaceColor}" Text="This is a third party app made by the community, for the community. Its aim is to bring additional safety features &amp; better data reporting to its users." />
                    <Label FontSize="14" TextColor="{DynamicResource MutedTextColor}" Text="This is not the official Onewheel app. It is not supported, endorsed or affiliated with Future Motion in any way." />
                </VerticalStackLayout>
            </Border>

            <Label Text="App" Style="{StaticResource SectionHeaderStyle}" />
            <views:SettingsGroup>
                <views:SettingsItem Title="Version">
                    <Label Text="{Binding VersionString}" FontSize="16" TextColor="{DynamicResource MutedTextColor}" />
                </views:SettingsItem>
            </views:SettingsGroup>

            <Label Text="Help" Style="{StaticResource SectionHeaderStyle}" />
            <views:SettingsGroup>
                <views:SettingsItem Title="OWCE FAQ" ShowChevron="True" Command="{Binding FAQCommand}" />
                <views:SettingsItem Title="Report a problem" ShowChevron="True" Command="{Binding ReportProblemCommand}" />
                <views:SettingsItem Title="Request a feature" ShowChevron="True" Command="{Binding RequestFeatureCommand}" />
            </views:SettingsGroup>

            <Label Text="Community" Style="{StaticResource SectionHeaderStyle}" />
            <views:SettingsGroup>
                <views:SettingsItem Title="GitHub" Subtitle="Source code" ShowChevron="True" Command="{Binding SourceCodeCommand}" />
                <views:SettingsItem Title="Reddit" ShowChevron="True" Command="{Binding RedditCommand}" />
                <views:SettingsItem Title="Twitter" ShowChevron="True" Command="{Binding TwitterCommand}" />
                <views:SettingsItem Title="Facebook page" Subtitle="For news" ShowChevron="True" Command="{Binding FacebookPageCommand}" />
                <views:SettingsItem Title="Facebook group" Subtitle="For discussions" ShowChevron="True" Command="{Binding FacebookGroupCommand}" />
            </views:SettingsGroup>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>

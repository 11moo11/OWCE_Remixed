<?xml version="1.0" encoding="UTF-8"?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:OWCE.Views"
    xmlns:converters="clr-namespace:OWCE.Converters"
    x:Class="OWCE.Views.SpeedRangeDistanceView">

    <ContentView.Resources>
        <converters:RpmToSpeedConverter x:Key="rpmToSpeedConverter" />
        <converters:DistanceConverter x:Key="distanceConverter" />
        <converters:RotationsToDistanceConverter x:Key="rotationsToDistanceConverter" />

        
    </ContentView.Resources>
    <Border BackgroundColor="{DynamicResource SpeedPanel}"  Style="{DynamicResource BoardDetailBlockBaseStyle}">

        <toolkit:Expander x:Name="ExpanderView" HorizontalOptions="Fill" PropertyChanged="ExpanderView_PropertyChanged">



            <toolkit:Expander.Header>

                <Grid x:Name="GridThing" ColumnSpacing="0" RowSpacing="0" >

                    <!--
            726.4854811913 is 40km/h converted to rpm with a 917.66mm circumference wheel.
            -->
                    <views:SpeedArcView HorizontalOptions="Fill" VerticalOptions="Fill" CurrentRPM="{Binding RPM}" MaxRPM="1000" MinRPM="0" />


                    <Label VerticalOptions="End" Margin="20,0" TextColor="{DynamicResource OnSpeedPanel}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontAttributes="Bold" Text="{Binding TripOdometer, Converter={StaticResource rotationsToDistanceConverter}}" FontSize="16"  />
                                <Span Text=" ride" FontSize="16"  />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>


                    <Label HorizontalTextAlignment="End" HorizontalOptions="Fill" VerticalOptions="End" Margin="20,0" TextColor="{DynamicResource OnSpeedPanel}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="lifetime "  FontSize="16" />

                                <Span FontAttributes="Bold" Text="{Binding LifetimeOdometer, Converter={StaticResource distanceConverter}, ConverterParameter='N0'}"  FontSize="16" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Text="SPEED" Style="{StaticResource PanelCaptionStyle}" TextColor="{DynamicResource OnSpeedPanel}" />
                    <Label FontAttributes="Bold" Text="{Binding RPM, Converter={StaticResource rpmToSpeedConverter}, ConverterParameter={Binding WheelCircumference}, StringFormat='{0:F0}'}"  TextColor="{DynamicResource OnSpeedPanel}"  FontSize="100" HorizontalOptions="Center" VerticalOptions="Start"  />

                    <Label FontAttributes="Bold" TextColor="{DynamicResource OnSpeedPanel}" FontSize="22" CharacterSpacing="0.5" HorizontalOptions="Center" VerticalOptions="End" VerticalTextAlignment="End">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Static Application.Current}, Path=MetricDisplay}" Value="true">
                              <Setter Property="Text" Value="km/h" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Static Application.Current}, Path=MetricDisplay}" Value="false">
                              <Setter Property="Text" Value="mph" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <views:ExpanderArrowView x:Name="ExpanderArrow" HorizontalOptions="End" Margin="17,13" ArrowColor="{DynamicResource OnSpeedPanel}" IsVisible="false" />
                </Grid>

            </toolkit:Expander.Header>
            <!--
            <Grid Grid.Row="1" HeightRequest="76" BackgroundColor="White" ColumnSpacing="0" ColumnDefinitions="Auto,Auto" Padding="10,0,0,0">
                <Button Grid.Column="0" BackgroundColor="White" HorizontalOptions="Start" VerticalOptions="Center" CornerRadius="20" Margin="10,0,0,0" Padding="15,0" TextColor="{DynamicResource OnSpeedPanel}" FontSize="18" FontFamily="SairaExtraCondensed-Bold" Text="Set alarm speed" BorderWidth="1" BorderColor="#DBDBDF" HeightRequest="40" />
            </Grid>
            -->
        </toolkit:Expander>
    </Border>


</ContentView>
